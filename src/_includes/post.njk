---
layout: base.njk
---

<article class="post-article">
  <div class="post-header">
    <div class="post-meta">
      <span class="num">{{ "▸ " + (collections.posts | postNum(page.url) | padNum) }}</span>
      <span>{{ page.date | dateISO }}</span>
      <span>·</span>
      <span>{{ tag }}</span>
      <span>·</span>
      <span>{{ content | readTime }} READ</span>
    </div>
    <h1>{{ title }}</h1>
    {% if description %}<p class="lede">{{ description }}</p>{% endif %}
    <p class="byline">By <span class="author">Jonathan Larkin</span></p>
  </div>

  <div class="post-body">
    {{ content | safe }}
  </div>

  <p class="post-note">
    {% if tag == "TALK" %}This presentation and post are{% else %}This post is{% endif %}
    for informational purposes only and
    {% if tag == "TALK" %}reflect{% else %}reflects{% endif %} my personal views and interests.
    {% if tag == "TALK" %}They do{% else %}It does{% endif %} not constitute investment advice and
    {% if tag == "TALK" %}are{% else %}is{% endif %} not representative of any current or former employer.
    The information presented is based on publicly available sources.
    References to specific firms are for illustrative purposes only and do
    not imply endorsement.
  </p>
  <p class="post-note post-license">
    Text licensed under
    <a href="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</a>.
    Code licensed under
    <a href="https://www.apache.org/licenses/LICENSE-2.0">Apache 2.0</a>.
  </p>

  <a href="/" class="back-link">▸ BACK TO INDEX</a>
</article>
