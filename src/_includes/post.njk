---
layout: base.njk
---

<article class="post-article">
  <div class="post-header">
    <div class="post-meta">
      <span class="num">{{ "▸ " + (collections.posts | length | padNum) }}</span>
      <span>{{ page.date | dateISO }}</span>
      <span>·</span>
      <span>{{ tag }}</span>
      <span>·</span>
      <span>{{ content | readTime }} READ</span>
    </div>
    <h1>{{ title }}</h1>
    {% if description %}<p class="lede">{{ description }}</p>{% endif %}
  </div>

  <div class="post-body">
    {{ content | safe }}
  </div>

  <a href="/" class="back-link">▸ BACK TO INDEX</a>
</article>
