---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.language }}">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.subtitle }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/" rel="alternate" type="text/html"/>
  <id>{{ site.url }}/</id>
  <author>
    <name>{{ site.author }}</name>
  </author>
  {%- if collections.posts and collections.posts[0] %}
  <updated>{{ collections.posts[0].date | rfc3339 }}</updated>
  {%- else %}
  <updated>{{ page.date | rfc3339 }}</updated>
  {%- endif %}
  {%- for post in collections.posts %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ site.url }}{{ post.url }}" rel="alternate" type="text/html"/>
    <id>{{ site.url }}{{ post.url }}</id>
    <published>{{ post.date | rfc3339 }}</published>
    <updated>{{ post.date | rfc3339 }}</updated>
    {%- if post.data.description %}
    <summary>{{ post.data.description }}</summary>
    {%- endif %}
    {%- if post.data.tag %}
    <category term="{{ post.data.tag }}"/>
    {%- endif %}
    <author>
      <name>{{ site.author }}</name>
    </author>
  </entry>
  {%- endfor %}
</feed>
