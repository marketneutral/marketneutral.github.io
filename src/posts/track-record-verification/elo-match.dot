// Source for elo-match.svg: one monthly match. Re-render with:
//   dot -Tsvg elo-match.dot -o elo-match.svg
digraph elo {
  rankdir=TB; bgcolor="transparent"; pad=0.25; nodesep=0.35; ranksep=0.5;
  fontname="IBM Plex Mono, Menlo, DejaVu Sans Mono, monospace";
  node [shape=box, style="rounded,filled", fillcolor="#131927", color="#2a3344",
        fontcolor="#e8eaf0", fontname="IBM Plex Mono, Menlo, DejaVu Sans Mono, monospace",
        fontsize=15, margin="0.12,0.12", penwidth=1.2, width=2.1, height=0.75, fixedsize=true];
  edge [color="#6b7280", arrowsize=0.7, penwidth=1.1,
        fontname="IBM Plex Mono, Menlo, DejaVu Sans Mono, monospace",
        fontsize=13, fontcolor="#9aa1ad"];
  A [label="signal A\nrating 1450"]; B [label="signal B\nrating 1520"];
  { rank=same; A; B; }
  CMP [label="compare on the\noverlapping window:\nSharpe, Sortino, drawdown", width=3.2, height=1.0];
  W [label="A wins", fillcolor="#0f1726", color="#3ee87a", fontcolor="#3ee87a"];
  A2 [label="signal A\n1465  ↑", fillcolor="#0f1726", color="#3ee87a", fontcolor="#3ee87a"]; B2 [label="signal B\n1505  ↓", fillcolor="#0a0e1a", color="#ff6b4a", fontcolor="#ff6b4a"];
  { rank=same; A2; B2; }
  A -> CMP; B -> CMP; CMP -> W; W -> A2; W -> B2;
}
