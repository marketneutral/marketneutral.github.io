// Source for signal-dag.svg: the SignalGraph qex builds for the final book. Re-render with:
//   dot -Tsvg signal-dag.dot -o signal-dag.svg
digraph alpha {
  rankdir=BT; bgcolor="transparent"; pad=0.3; nodesep=0.3; ranksep=0.5;
  node [shape=box, style="rounded,filled", fillcolor="#131927", color="#2a3344",
        fontcolor="#e8eaf0", fontname="IBM Plex Mono, DejaVu Sans Mono, monospace",
        fontsize=13, margin="0.16,0.10", penwidth=1.2];
  edge [color="#6b7280", arrowsize=0.6, penwidth=1.0];
  n0 [label="returns(1)", fillcolor="#0f1726", color="#3ee87a", fontcolor="#3ee87a"];
  n1 [label="field()", fillcolor="#0f1726", color="#3ee87a", fontcolor="#3ee87a"];
  n2 [label="*"];
  n3 [label="demean(·)"];
  n4 [label="-"];
  n5 [label="ts_std(·, 21, 20)"];
  n6 [label="ts_std(·, 252, 20)"];
  n7 [label=">"];
  n8 [label="10", fillcolor="#0f1726", color="#3ee87a", fontcolor="#3ee87a"];
  n9 [label="ts_sum(·, 252, 20)"];
  n10 [label="*"];
  n11 [label="1", fillcolor="#0f1726", color="#3ee87a", fontcolor="#3ee87a"];
  n12 [label="min(·, ·)"];
  n13 [label="negate"];
  n14 [label="max(·, ·)"];
  n15 [label="+"];
  n16 [label="min(·, ·)"];
  n17 [label="max(·, ·)"];
  n18 [label="where(·, ·, ·)"];
  n19 [label="ts_beta(·, ·, 504, 20)", fillcolor="#0f1726", color="#3ee87a", fontcolor="#3ee87a"];
  n20 [label="*"];
  n21 [label="-"];
  n22 [label="ts_sum(·, 231, 20)"];
  n23 [label="delay(·, 21)"];
  n24 [label="group_demean(·, sector)"];
  n25 [label="*"];
  n26 [label="decay_linear(·, 10)"];
  n27 [label="returns(21)", fillcolor="#0f1726", color="#3ee87a", fontcolor="#3ee87a"];
  n28 [label="group_demean(·, sector)"];
  n29 [label="-"];
  n30 [label="power(·, 3)"];
  n31 [label="decay_linear(·, 3)", fillcolor="#3ee87a", color="#3ee87a", fontcolor="#0a0e1a"];
  n0 -> n2;
  n1 -> n2;
  n2 -> n3;
  n2 -> n4;
  n3 -> n4;
  n4 -> n5;
  n4 -> n6;
  n5 -> n7;
  n6 -> n7;
  n4 -> n9;
  n8 -> n10;
  n9 -> n10;
  n10 -> n12;
  n11 -> n12;
  n11 -> n13;
  n12 -> n14;
  n13 -> n14;
  n10 -> n15;
  n11 -> n15;
  n15 -> n16;
  n11 -> n16;
  n16 -> n17;
  n13 -> n17;
  n7 -> n18;
  n14 -> n18;
  n17 -> n18;
  n19 -> n20;
  n4 -> n20;
  n0 -> n21;
  n20 -> n21;
  n21 -> n22;
  n22 -> n23;
  n23 -> n24;
  n18 -> n25;
  n24 -> n25;
  n25 -> n26;
  n27 -> n28;
  n26 -> n29;
  n28 -> n29;
  n29 -> n30;
  n30 -> n31;
}
